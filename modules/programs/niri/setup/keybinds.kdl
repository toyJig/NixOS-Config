binds {
    // Noctalia Application Menu
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }

    // Utility
    Mod+Shift+S {
        screenshot show-pointer=false
    }
    Mod+T {
        spawn "kitty"
    }
    Mod+Y {
        spawn "dolphin"
    }
    Mod+Shift+Comma {
        spawn-sh "noctalia" "msg" "settings-toggle";
    }

    // Workspace Navigation
    Mod+Up {
        focus-workspace-up
    }
    Mod+Down {
        focus-workspace-down
    }
    Mod+Shift+Up {
        move-window-to-workspace-up
    }
    Mod+Shift+Down {
        move-window-to-workspace-down
    }

    Mod+Right {
        focus-column-right
    }
    Mod+Left {
        focus-column-left
    }
    Mod+Shift+Left {
        move-column-left
    }
    Mod+Shift+Right {
        move-column-right
    }

    Mod+Tab {
        toggle-overview
    }

    Mod+O {
        toggle-window-floating
    }
    Mod+P {
        switch-focus-between-floating-and-tiling
    }

    // Workspace Selection
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }

    // Window & Column Controls
    Mod+R {
        switch-preset-column-width
    }
    Mod+F {
        maximize-column
    }

    // Critical Default Binds
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    Mod+Q {
        close-window
    }
    Mod+Return {
        spawn "foot"
    }

    // Audio
    XF86AudioRaiseVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"
    }
    XF86AudioLowerVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"
    }

    // Brightness
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down";
    }
}
