binds {
    // Noctalia Application Menu
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }

    // Utility
    Mod+Shift+S { screenshot show-pointer=false; }
    Mod+Return { spawn "kitty"; }
    Mod+Y { spawn "dolphin"; }
    Mod+Ctrl+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Alt+N allow-when-locked=true hotkey-overlay-title="Toggle Night Mode" { spawn "noctalia" "msg" "nightlight-toggle"; }
    Mod+N hotkey-overlay-title="Toggle Notification Center" { spawn "noctalia" "msg" "control-center-notifications"; }
    Mod+X hotkey-overlay-title="Toggle Power Menu" { spawn "noctalia" "msg" "session-panel"; }

    // Workspace Navigation
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+J { move-column-to-workspace-down; }

    Mod+Right { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+L { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }


    Mod+Tab { toggle-overview; }

    Mod+W { close-window; }
    Mod+O { toggle-window-floating; }
    Mod+P { switch-focus-between-floating-and-tiling; }

    //Mouse controls
    Mod+WheelScrollUp cooldown-ms=100 { focus-column-left; }
    Mod+WheelScrollDown cooldown-ms=100 { focus-column-right; }
    Mod+Shift+WheelScrollUp cooldown-ms=100 { move-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=100 { move-column-right; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=100 { move-window-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=100 { move-window-to-workspace-down; }

    // Workspace Selection
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Window & Column Controls
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+0 { maximize-column; }

    Mod+Minus { set-window-width "-10%"; }
    Mod+Equal { set-window-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+R { reset-window-height; }
    Mod+Shift+0 { reset-window-height; }

    //Tabs
    Mod+Shift+Comma { consume-or-expel-window-left; }
    Mod+Shift+Period { consume-or-expel-window-right; }
    Mod+T { toggle-column-tabbed-display; }

    // Audio
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // Brightness
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down"; }

    //Unused Monitor binds
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
}
