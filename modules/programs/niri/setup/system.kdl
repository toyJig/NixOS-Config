input {
    touchpad {
	tap
	drag false
	natural-scroll
	scroll-factor 0.65
    }

    mouse {
	accel-profile "flat"
    }

    keyboard {
	repeat-delay 180
	repeat-rate 20
    }
}

gestures {
    hot-corners {
	off
    }
}

hotkey-overlay {
    skip-at-startup
}

clipboard {
    disable-primary
}

debug {
    render-drm-device "/dev/dri/by-path/pci-0000:65:00.0-render"
    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-card"
}
