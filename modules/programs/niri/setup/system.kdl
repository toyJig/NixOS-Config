input {
	touchpad {
		tap
		drag false
		natural-scroll
	}

	mouse {
		accel-profile "flat"
	}

	keyboard {
		repeat-delay 180
		repeat-rate 20
	}
}

hotkey-overlay {
	skip-at-startup
}

clipboard {
	disable-primary
}

debug {
    // Force Niri to use the iGPU
    render-drm-device "/dev/dri/renderD128"
}
